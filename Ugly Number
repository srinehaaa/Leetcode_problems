//ugly number - An ugly number is a positive integer whose only prime factors are 2, 3, and 5, with 1 included by convention.


class Solution:
    def isUgly(self, n: int) -> bool:
        if n<=0:
            return False

        for factor in [2,3,5]:
            while n%factor==0:
                n//=factor

        return n==1
